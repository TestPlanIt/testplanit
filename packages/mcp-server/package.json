{
  "name": "@testplanit/mcp-server",
  "version": "0.3.1",
  "description": "Model Context Protocol server for TestPlanIt — exposes test-case data to AI agents over stdio.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "testplanit-mcp-server": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:cov": "vitest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "testplanit",
    "mcp",
    "model-context-protocol",
    "ai",
    "agent",
    "test-management"
  ],
  "author": "TestPlanIt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TestPlanIt/testplanit.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/testplanit/testplanit/issues"
  },
  "homepage": "https://github.com/testplanit/testplanit/tree/main/packages/mcp-server#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public",
    "tag": "latest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prisma/client": "~6.19.3",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
