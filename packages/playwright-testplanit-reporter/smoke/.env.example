# Copy to smoke/.env and fill in. Load before running:
#   set -a; . smoke/.env; set +a

# --- Required: connection ---
TPI_DOMAIN=http://localhost:3000
TPI_TOKEN=tpi_your_token_here
TPI_PROJECT_ID=1

# --- Mode A: tag tests with existing case IDs (leave TPI_AUTOCREATE unset) ---
# TPI_CASE_PASS=101
# TPI_CASE_FAIL=102
# TPI_CASE_SKIP=103

# --- Mode B: auto-create cases (no existing IDs needed) ---
# Quote any value containing spaces so `set -a; . smoke/.env` doesn't word-split it.
# TPI_AUTOCREATE=1
# TPI_PARENT_FOLDER="Playwright Smoke"      # created if missing
# TPI_TEMPLATE="Default Template"           # template ID or name (required for auto-create)

# --- Optional ---
# TPI_BROWSER=chromium                      # surfaces as {browser} in the run name
# TPI_RETRIES=0                             # bump to see retries report multiple results
