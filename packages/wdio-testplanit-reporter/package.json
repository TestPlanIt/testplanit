{
  "name": "@testplanit/wdio-reporter",
  "version": "1.0.0-beta.4",
  "description": "WebdriverIO reporter for TestPlanIt - report test results directly to your TestPlanIt instance",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:cov": "vitest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "webdriverio",
    "wdio",
    "reporter",
    "testplanit",
    "test-management",
    "test-reporting",
    "automation"
  ],
  "author": "TestPlanIt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TestPlanIt/testplanit.git",
    "directory": "packages/wdio-testplanit-reporter"
  },
  "bugs": {
    "url": "https://github.com/testplanit/testplanit/issues"
  },
  "homepage": "https://github.com/testplanit/testplanit/tree/main/packages/wdio-testplanit-reporter#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public",
    "tag": "latest"
  },
  "peerDependencies": {
    "@wdio/reporter": "^8.0.0 || ^9.0.0",
    "@wdio/types": "^8.0.0 || ^9.0.0"
  },
  "dependencies": {
    "@testplanit/api": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@wdio/reporter": "^9.29.1",
    "@wdio/types": "^9.29.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
