# E2E Test Environment Configuration
# Copy this file to .env.e2e and configure for your E2E test environment
# This should point to a SEPARATE database from your development database

# Database - Use a dedicated E2E test database
# IMPORTANT: This database will be reset/seeded before each test run
DATABASE_URL="postgresql://user:password@localhost:5432/testplanit_e2e?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=e2e-test-secret-do-not-use-in-production

# Valkey/Redis (can share with dev if isolated, or use separate instance)
VALKEY_URL="valkey://localhost:6379"

# Elasticsearch (optional for E2E - can be disabled)
# ELASTICSEARCH_NODE=http://localhost:9200

# MinIO/S3 Configuration (optional for E2E tests)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_REGION=us-east-1
AWS_BUCKET_NAME=testplanit-e2e
AWS_ENDPOINT_URL=http://localhost:9000

# Encryption key
ENCRYPTION_KEY=e2e-test-encryption-key-32-chars-

# Default Admin User for E2E tests
ADMIN_EMAIL=admin@example.com
ADMIN_NAME="Administrator Account"
ADMIN_PASSWORD=admin

# Test user
TEST_REGULAR_USER_PASSWORD=password123

# ===== SCIM Okta E2E =====
# Required when RUN_OKTA_E2E=1; see docs/api/scim.md for the setup walkthrough.
# Copy this file to .env.e2e (gitignored) and fill in your dev-tenant values.
OKTA_ORG_URL=
OKTA_API_TOKEN=
OKTA_SCIM_APP_ID=

# Disable the per-token SCIM rate-limit (50 RPS) during the E2E burst. The
# 9-step Okta lifecycle would otherwise hit 429s mid-run on a slow tenant.
DISABLE_SCIM_RATE_LIMIT=true
