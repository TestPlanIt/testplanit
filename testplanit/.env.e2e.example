# E2E Test Environment Configuration
# Copy this file to .env.e2e. The defaults match docker-compose.e2e.yml:
#   docker compose -f docker-compose.e2e.yml up -d
# Keep it pointed at SEPARATE services from your development environment.

# Database - Use a dedicated E2E test database
# IMPORTANT: This database will be reset/seeded before each test run
DATABASE_URL="postgresql://user:password@localhost:5433/tpi_test?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3002"
NEXTAUTH_SECRET=e2e-test-secret-do-not-use-in-production

# Valkey/Redis
VALKEY_URL="valkey://localhost:6377"

# Elasticsearch (search, report and share specs need it)
ELASTICSEARCH_NODE=http://localhost:9221

# S3-compatible storage (upload specs need it; e2e/setup-db.ts verifies it)
AWS_ACCESS_KEY_ID=e2e-access-key
AWS_SECRET_ACCESS_KEY=e2e-secret-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=testplanit-e2e
AWS_ENDPOINT_URL=http://localhost:9100

# Encryption key
ENCRYPTION_KEY=e2e-test-encryption-key-32-chars-

# Default Admin User for E2E tests
ADMIN_EMAIL=admin@example.com
ADMIN_NAME="Administrator Account"
ADMIN_PASSWORD=admin

# Test user
TEST_REGULAR_USER_PASSWORD=password123

# ===== SCIM smoke harness =====
# Used by `pnpm scim:smoke` (see docs/api/scim.md). Copy this file to .env.e2e
# (gitignored). The smoke harness exercises every SCIM endpoint against your
# local server in under 10s and does NOT require a real IdP tenant. The
# Okta/Entra/OneLogin tenant variables below are only needed if you decide to
# drive a one-time live operator UAT (advisory; not a milestone gate).
OKTA_ORG_URL=
OKTA_API_TOKEN=
OKTA_SCIM_APP_ID=

# Disable the per-token SCIM rate-limit (50 RPS) if you drive a high-volume
# operator UAT against your dev tenant.
DISABLE_SCIM_RATE_LIMIT=true

# Outbound execution dispatch may target the E2E stub server on the loopback address.
ALLOWED_PRIVATE_HOSTS=127.0.0.1
