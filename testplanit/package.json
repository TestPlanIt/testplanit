{
  "name": "testplanit",
  "version": "0.40.9",
  "private": true,
  "scripts": {
    "audit:coverage": "tsx scripts/audit-coverage.ts",
    "reconcile:coverage": "tsx scripts/reconcile-audit-coverage.ts",
    "generate": "zenstack format --schema schema.zmodel && zenstack generate --schema schema.zmodel -o zenstack",
    "generate:dev": "zenstack format --schema schema.zmodel && zenstack generate --schema schema.zmodel -o zenstack",
    "db:migrate": "zenstack migrate dev --schema schema.zmodel",
    "db:migrate:dev": "dotenv -e .env.development -- zenstack migrate dev --schema schema.zmodel",
    "db:deploy": "zenstack migrate deploy --schema schema.zmodel",
    "db:status": "zenstack migrate status --schema schema.zmodel",
    "db:push": "zenstack db push --schema schema.zmodel",
    "triggers:apply": "tsx scripts/apply-triggers.ts",
    "triggers:apply:dev": "dotenv -e .env.development -- tsx scripts/apply-triggers.ts",
    "build": "node scripts/generate-version.js && pnpm build:workers && NODE_OPTIONS='--max-old-space-size=4096' next build",
    "build:workers": "node scripts/build-workers.js",
    "build:docs": "pnpm --filter docs build",
    "dev": "next dev",
    "dev:testdb": "dotenv -e .env.test -- pnpm dev",
    "postinstall": "zenstack format --schema schema.zmodel && zenstack generate --schema schema.zmodel -o zenstack",
    "lint": "eslint . && tsc --noEmit",
    "type-check": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit",
    "format": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "format:check": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore .",
    "precommit": "zenstack format && pnpm lint && pnpm format:check && pnpm test run && pnpm build:docs",
    "check:modal-pattern": "bash scripts/check-modal-pattern.sh",
    "start": "next start",
    "test": "vitest --config vitest.config.mts",
    "test:unit": "vitest --config vitest.config.mts",
    "test:cov": "vitest run --coverage --config vitest.config.mts",
    "test:e2e": "dotenv -e .env.e2e -- playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "dotenv -e .env.e2e -- playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:debug": "dotenv -e .env.e2e -- playwright test --config e2e/playwright.config.ts --debug",
    "test:e2e:headed": "dotenv -e .env.e2e -- playwright test --config e2e/playwright.config.ts --headed",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "test:e2e:setup-db": "dotenv -e .env.e2e -- tsx e2e/setup-db.ts",
    "test:e2e:run": "pnpm test:e2e:setup-db && pnpm test:e2e",
    "test:e2e:prod": "pnpm build && dotenv -e .env.e2e -- cross-env E2E_PROD=on playwright test --config e2e/playwright.config.ts",
    "a11y:scan": "dotenv -e .env.e2e -- tsx e2e/a11y/run.ts",
    "a11y:report": "dotenv -e .env.e2e -- tsx e2e/a11y/aggregate.ts",
    "worker:notification": "dotenv -- tsx workers/notificationWorker.ts",
    "worker:email": "dotenv -- tsx workers/emailWorker.ts",
    "worker:forecast": "dotenv -- tsx workers/forecastWorker.ts",
    "worker:sync": "dotenv -- tsx workers/syncWorker.ts",
    "worker:testmo-import": "NODE_OPTIONS='--max-old-space-size=8192' dotenv -- tsx workers/testmoImportWorker.ts",
    "worker:elasticsearch-reindex": "dotenv -- tsx workers/elasticsearchReindexWorker.ts",
    "worker:audit-log": "dotenv -- tsx workers/auditLogWorker.ts",
    "worker:budget-alert": "dotenv -- tsx workers/budgetAlertWorker.ts",
    "worker:auto-tag": "dotenv -- tsx workers/autoTagWorker.ts",
    "worker:derive-case-steps": "dotenv -- tsx workers/deriveCaseStepsWorker.ts",
    "worker:repo-cache": "dotenv -- tsx workers/repoCacheWorker.ts",
    "worker:copy-move": "dotenv -- tsx workers/copyMoveWorker.ts",
    "worker:duplicate-scan": "dotenv -- tsx workers/duplicateScanWorker.ts",
    "worker:magic-select": "dotenv -- tsx workers/magicSelectWorker.ts",
    "worker:step-scan": "dotenv -- tsx workers/stepSequenceScanWorker.ts",
    "worker:generate-from-url": "dotenv -- tsx workers/generateFromUrlWorker.ts",
    "worker:iteration-generation": "dotenv -- tsx workers/iterationGenerationWorker.ts",
    "worker:scim-access-recompute": "dotenv -- tsx workers/scimAccessRecomputeWorker.ts",
    "worker:webhook-dispatch": "dotenv -- tsx workers/webhookDispatchWorker.ts",
    "worker:webhook-outbox": "dotenv -- tsx workers/webhookOutboxWorker.ts",
    "worker:webhook-retention": "dotenv -- tsx workers/webhookRetentionWorker.ts",
    "worker:dcl-retention": "dotenv -- tsx workers/dataChangeLogRetentionWorker.ts",
    "forecast:trigger": "dotenv -- tsx scripts/trigger-forecast-recalc.ts",
    "milestone-notifications:trigger": "dotenv -- tsx scripts/trigger-milestone-notifications.ts",
    "testmo-import:clear": "dotenv -- tsx scripts/clear-testmo-import-queue.ts",
    "queues:clear": "dotenv -- tsx scripts/clear-all-queues.ts",
    "workers": "dotenv -- concurrently \"pnpm worker:notification\" \"pnpm worker:email\" \"pnpm worker:forecast\" \"pnpm worker:sync\" \"pnpm worker:testmo-import\" \"pnpm worker:elasticsearch-reindex\" \"pnpm worker:audit-log\" \"pnpm worker:budget-alert\" \"pnpm worker:auto-tag\" \"pnpm worker:derive-case-steps\" \"pnpm worker:repo-cache\" \"pnpm worker:copy-move\" \"pnpm worker:duplicate-scan\" \"pnpm worker:magic-select\" \"pnpm worker:step-scan\" \"pnpm worker:generate-from-url\" \"pnpm worker:iteration-generation\" \"pnpm worker:scim-access-recompute\" \"pnpm worker:webhook-dispatch\" \"pnpm worker:webhook-outbox\" \"pnpm worker:webhook-retention\" \"pnpm worker:dcl-retention\"",
    "scheduler": "dotenv -- tsx scheduler.ts",
    "start:workers": "dotenv -- sh -c 'pnpm scheduler && pnpm workers'",
    "start:workers:prod": "pnpm build:workers && dotenv -- sh -c 'node dist/scheduler.js && concurrently \"node dist/workers/notificationWorker.js\" \"node dist/workers/emailWorker.js\" \"node dist/workers/forecastWorker.js\" \"node dist/workers/syncWorker.js\" \"node --max-old-space-size=8192 dist/workers/testmoImportWorker.js\" \"node dist/workers/elasticsearchReindexWorker.js\" \"node dist/workers/auditLogWorker.js\" \"node dist/workers/budgetAlertWorker.js\" \"node dist/workers/autoTagWorker.js\" \"node dist/workers/deriveCaseStepsWorker.js\" \"node dist/workers/repoCacheWorker.js\" \"node dist/workers/copyMoveWorker.js\" \"node dist/workers/duplicateScanWorker.js\" \"node dist/workers/magicSelectWorker.js\" \"node dist/workers/stepSequenceScanWorker.js\" \"node dist/workers/generateFromUrlWorker.js\" \"node dist/workers/iterationGenerationWorker.js\" \"node dist/workers/scimAccessRecomputeWorker.js\" \"node dist/workers/webhookDispatchWorker.js\" \"node dist/workers/webhookOutboxWorker.js\" \"node dist/workers/webhookRetentionWorker.js\" \"node dist/workers/dataChangeLogRetentionWorker.js\"'",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "crowdin:upload:sources": "crowdin upload sources",
    "crowdin:upload:translations": "crowdin upload translations",
    "crowdin:download": "crowdin download",
    "crowdin:pre-translate": "crowdin pre-translate --method=ai --ai-prompt=536391",
    "crowdin:sync": "pnpm crowdin:upload:sources && pnpm crowdin:pre-translate && pnpm crowdin:download",
    "elasticsearch:reindex": "tsx scripts/reindexAllEntities.ts",
    "elasticsearch:reindex:fresh": "tsx scripts/reindexAllEntities.ts --fresh",
    "elasticsearch:reindex:cases": "tsx scripts/reindexElasticsearch.ts",
    "scim:check-group-dupes": "tsx scripts/check-group-external-id-dupes.ts",
    "scim:smoke": "tsx scripts/scim-smoke.ts",
    "release:info": "echo 'Releases are now managed by release-please. Push to main and a Release PR will be created automatically.'"
  },
