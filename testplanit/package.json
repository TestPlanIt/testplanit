    "crowdin:upload:translations": "sh scripts/crowdin.sh translations",
    "crowdin:download": "sh scripts/crowdin.sh download",
    "crowdin:auto-translate": "sh scripts/crowdin.sh auto-translate",
    "crowdin:sync": "sh scripts/crowdin.sh sync",
    "crowdin:target": "sh scripts/crowdin.sh target",
    "elasticsearch:reindex": "tsx scripts/reindexAllEntities.ts",
    "elasticsearch:reindex:fresh": "tsx scripts/reindexAllEntities.ts --fresh",
    "elasticsearch:reindex:cases": "tsx scripts/reindexElasticsearch.ts",
