    "worker:audit-log-retention": "dotenv -- tsx workers/auditLogRetentionWorker.ts",
    "worker:failure-triage": "dotenv -- tsx workers/failureTriageWorker.ts",
    "worker:risk-score": "dotenv -- tsx workers/riskScoreWorker.ts",
    "worker:dataset-lease-sweep": "dotenv -- tsx workers/datasetLeaseSweepWorker.ts",
    "worker:execution-dispatch": "dotenv -- tsx workers/executionDispatchWorker.ts",
    "worker:alert": "dotenv -- tsx workers/alertWorker.ts",
    "worker:webhook-actions": "dotenv -- tsx workers/webhookActionsWorker.ts",
    "forecast:trigger": "dotenv -- tsx scripts/trigger-forecast-recalc.ts",
    "milestone-notifications:trigger": "dotenv -- tsx scripts/trigger-milestone-notifications.ts",
    "testmo-import:clear": "dotenv -- tsx scripts/clear-testmo-import-queue.ts",
    "queues:clear": "dotenv -- tsx scripts/clear-all-queues.ts",
    "workers": "dotenv -- concurrently \"pnpm worker:notification\" \"pnpm worker:email\" \"pnpm worker:forecast\" \"pnpm worker:sync\" \"pnpm worker:testmo-import\" \"pnpm worker:elasticsearch-reindex\" \"pnpm worker:audit-log\" \"pnpm worker:budget-alert\" \"pnpm worker:auto-tag\" \"pnpm worker:derive-case-steps\" \"pnpm worker:repo-cache\" \"pnpm worker:copy-move\" \"pnpm worker:duplicate-scan\" \"pnpm worker:magic-select\" \"pnpm worker:impact-analysis\" \"pnpm worker:step-scan\" \"pnpm worker:storage-scan\" \"pnpm worker:generate-from-url\" \"pnpm worker:iteration-generation\" \"pnpm worker:scim-access-recompute\" \"pnpm worker:webhook-dispatch\" \"pnpm worker:webhook-outbox\" \"pnpm worker:webhook-retention\" \"pnpm worker:dcl-retention\" \"pnpm worker:audit-log-retention\" \"pnpm worker:dataset-lease-sweep\" \"pnpm worker:execution-dispatch\" \"pnpm worker:alert\" \"pnpm worker:webhook-actions\" \"pnpm worker:failure-triage\" \"pnpm worker:risk-score\"",
    "scheduler": "dotenv -- tsx scheduler.ts",
    "start:workers": "dotenv -- sh -c 'pnpm scheduler && pnpm workers'",
    "start:workers:prod": "pnpm build:workers && dotenv -- sh -c 'node dist/scheduler.js && concurrently \"node dist/workers/notificationWorker.js\" \"node dist/workers/emailWorker.js\" \"node dist/workers/forecastWorker.js\" \"node dist/workers/syncWorker.js\" \"node --max-old-space-size=8192 dist/workers/testmoImportWorker.js\" \"node dist/workers/elasticsearchReindexWorker.js\" \"node dist/workers/auditLogWorker.js\" \"node dist/workers/budgetAlertWorker.js\" \"node dist/workers/autoTagWorker.js\" \"node dist/workers/deriveCaseStepsWorker.js\" \"node dist/workers/repoCacheWorker.js\" \"node dist/workers/copyMoveWorker.js\" \"node dist/workers/duplicateScanWorker.js\" \"node dist/workers/magicSelectWorker.js\" \"node dist/workers/impactAnalysisWorker.js\" \"node dist/workers/stepSequenceScanWorker.js\" \"node dist/workers/storageScanWorker.js\" \"node dist/workers/generateFromUrlWorker.js\" \"node dist/workers/iterationGenerationWorker.js\" \"node dist/workers/scimAccessRecomputeWorker.js\" \"node dist/workers/webhookDispatchWorker.js\" \"node dist/workers/webhookOutboxWorker.js\" \"node dist/workers/webhookRetentionWorker.js\" \"node dist/workers/dataChangeLogRetentionWorker.js\" \"node dist/workers/auditLogRetentionWorker.js\" \"node dist/workers/datasetLeaseSweepWorker.js\" \"node dist/workers/executionDispatchWorker.js\" \"node dist/workers/alertWorker.js\" \"node dist/workers/webhookActionsWorker.js\" \"node dist/workers/failureTriageWorker.js\" \"node dist/workers/riskScoreWorker.js\"'",
