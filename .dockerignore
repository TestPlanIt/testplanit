# Root build context ignore. The testplanit image builds from the repo root so
# it can use the single root pnpm-lock.yaml + pnpm-workspace.yaml.
#
# IMPORTANT: this file is kept NEGATION-FREE (no `!` re-include patterns). In
# BuildKit, a single `!` exception disables directory pruning, forcing the
# context walker to descend into EVERY directory — including docker-data/postgres,
# which is uid-owned and unreadable by the build user, causing the build to fail
# with "error from sender: ... permission denied". Enumerate excludes instead of
# excluding-then-re-including.

# Dependencies & framework caches — safe to match at any depth (never source).
**/node_modules
**/.next
**/.turbo
**/.docusaurus
**/*.tsbuildinfo

# Build output & test artifacts — regenerated in-image; anchored, not floating.
# NOTE: packages/api/dist is intentionally NOT excluded — it ships committed and
# the app imports it, so the image build needs it.
testplanit/dist
testplanit/build
testplanit/coverage
testplanit/test-results
testplanit/playwright-report
testplanit/e2e
docs/build
docs/.docusaurus
forge-app/dist
cli/dist
packages/mcp-server/dist
packages/playwright-testplanit-reporter/dist
packages/wdio-testplanit-reporter/dist

# Large local data & prebuilt binaries — never needed in the image.
# docker-data holds container volumes (e.g. postgres) that are uid-owned and
# unreadable by the build user; excluded here so the walker prunes them.
testplanit/backups
**/docker-data
**/docker-data/**
cli/releases
.playwright-mcp
demo/

# VCS, env, editor, OS cruft. Exclude ALL env files (default-deny) so no secret
# variant — including odd suffixes like .env.production.backup or ".env.production
# copy" — can be baked into the image. This MUST stay negation-free: a `!` re-include
# (e.g. `!**/.env.example`) disables BuildKit's directory pruning, forcing the context
# walker to descend into the uid-owned, unreadable docker-data/postgres and fail the
# build. .env.example is a committed dev reference and is not read at build or runtime,
# so it does not need to ship.
.git
**/.git
**/.env
**/.env.*
**/.DS_Store
**/npm-debug.log*

# Planning (local-only).
**/.planning/
